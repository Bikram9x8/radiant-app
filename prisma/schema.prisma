// Radiant Educations — Prisma Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ================= ENUMS =================

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum AccountStatus {
  PENDING     // company awaiting admin approval
  APPROVED
  REJECTED
  BLOCKED
}

enum OpportunityType {
  JOB
  INTERNSHIP
  COMPETITION
  QUIZ
  SOLUTION
  HACKATHON
  EVENT
}

enum OpportunityStatus {
  PENDING     // awaiting admin approval
  APPROVED
  REJECTED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  SELECTED
}

enum Division {
  NCERT_SOLUTION
  CBSE_SAMPLE_PAPERS
  TEST_SERIES
  SKILL_BUILDING
  CAREER_COUNSELING
  STUDY_PACKAGE
  DPP
  BOARD_LEVEL_TEST
  CHAPTER_WISE_TEST
}

// ================= CORE =================

enum NotificationType {
  APPLICATION_UPDATE
  OPPORTUNITY_APPROVED
  OPPORTUNITY_REJECTED
  COMPANY_APPROVED
  COMPANY_REJECTED
  ACCOUNT_BLOCKED
  GENERAL
}

// ================= CORE =================

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  role          Role
  status        AccountStatus @default(APPROVED) // students auto-approved; companies start PENDING
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  studentProfile  StudentProfile?
  companyProfile  CompanyProfile?
  notifications   Notification[]
  adminLogsMade   AdminLog[]      @relation("AdminActor")

  @@index([role])
  @@index([status])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String
  phone         String?
  college       String?
  degree        String?
  graduationYr  Int?
  skills        String[] @default([])
  bio           String?
  linkedinUrl   String?
  githubUrl     String?
  portfolioUrl  String?
  avatarUrl     String?

  resumes       Resume[]
  applications  Application[]
  mcqAttempts   McqAttempt[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CompanyProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName   String
  website       String?
  industry      String?
  description   String?
  logoUrl       String?
  contactPerson String?
  contactPhone  String?

  opportunities Opportunity[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Resume {
  id            String   @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fileUrl       String   // Cloudinary/S3 URL
  fileName      String
  isPrimary     Boolean  @default(true)
  uploadedAt    DateTime @default(now())
}

model Category {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  opportunities Opportunity[]
  createdAt     DateTime @default(now())
}

model Opportunity {
  id            String            @id @default(cuid())
  companyId     String
  company       CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id])

  title         String
  type          OpportunityType
  description   String
  eligibility   String?
  location      String?
  mode          String            @default("Online") // Online / Offline / Hybrid
  stipendOrPrize String?
  duration      String?           // internships, e.g. "3 months"
  applyDeadline DateTime
  eventDate     DateTime?
  externalLink  String?           // optional external application link
  requiresCode  Boolean           @default(false)
  accessCodes   AccessCode[]
  division      Division          @default(TEST_SERIES)
  chapter       Int?

  status        OpportunityStatus @default(PENDING)
  rejectionReason String?

  applications  Application[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  courseNodeId  String?
  courseNode    CourseNode?       @relation(fields: [courseNodeId], references: [id], onDelete: SetNull)
  contentType   String?           // NOTES | SOLUTION | TEST | MCQ_TEST | PYQ | DPP ...

  @@index([status])
  @@index([type])
  @@index([applyDeadline])
  @@index([courseNodeId])
}
model AccessCode {
  id            String       @id @default(cuid())
  code          String       @unique

  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  isUsed        Boolean      @default(false)
  usedByUserId  String?
  usedAt        DateTime?

  isLocked      Boolean      @default(false)
  lockedAt      DateTime?
  lockReason    String?

  createdAt     DateTime     @default(now())

  @@index([opportunityId])
}

model Application {
  id            String            @id @default(cuid())
  studentId     String
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  resumeUrl     String?           // snapshot of resume used at time of application
  coverNote     String?
  status        ApplicationStatus @default(APPLIED)

  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([studentId, opportunityId]) // one application per student per opportunity
  @@index([status])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, isRead])
}

model AdminLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("AdminActor", fields: [actorId], references: [id])

  action      String   // e.g. "APPROVE_COMPANY", "BLOCK_USER", "REJECT_OPPORTUNITY"
  targetType  String   // "User" | "Opportunity" | "Company"
  targetId    String
  notes       String?

  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}
// ================= COURSE TREE =================
// One self-referencing table for the whole structure:
//   COURSE (CBSE / ICSE / Competitive / Vocational)
//     -> LEVEL (Class 12, JEE, Geeta ...)
//       -> STAGE (optional, e.g. UPSC Prelims / Mains)
//         -> SUBJECT (Physics ...)
//           -> CHAPTER (Chapter 2 ...)
// Different branches can have different depth (Geeta is COURSE -> LEVEL -> CHAPTER).

model CourseNode {
  id            String       @id @default(cuid())
  parentId      String?
  parent        CourseNode?  @relation("CourseTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      CourseNode[] @relation("CourseTree")

  name          String
  slug          String
  kind          String       // COURSE | LEVEL | STAGE | SUBJECT | CHAPTER
  position      Int          @default(0)   // display order among siblings
  chapterNo     Int?
  bookName      String?
  tags          String[]     @default([])  // e.g. SCIENCE_PCM, SCIENCE_PCB, COMMERCE, ARTS (Class 11-12 streams)
  contentTypes  String[]     @default([])  // only set on COURSE nodes: the tabs shown for that course
  isActive      Boolean      @default(true)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  opportunities Opportunity[]
  mcqQuestions  McqQuestion[]
  mcqTests      McqTest[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([kind])
}
model ProblemReport {
  id         String   @id @default(cuid())
  category   String   // WRONG_CONTENT | FILE_PROBLEM | LOGIN_ACCOUNT | OTHER
  message    String
  pageUrl    String?
  email      String?
  userId     String?
  status     String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
model PageView {
  id            String   @id @default(cuid())
  path          String
  courseNodeId  String?
  opportunityId String?
  userId        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([courseNodeId])
  @@index([opportunityId])
}

// ================= MCQ TESTS =================

enum McqOption {
  A
  B
  C
  D
}

// Question bank: each question belongs to one CHAPTER node (cbse, icse or competitive only;
// enforced in the API, not the schema).
model McqQuestion {
  id            String     @id @default(cuid())
  chapterId     String
  chapter       CourseNode @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  text          String     // plain text for now; a format field can be added later for LaTeX
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption McqOption
  explanation   String?
  imageUrl      String?    // one optional image, shown with the question text
  isActive      Boolean    @default(true) // deactivate instead of delete, so old attempts stay readable
  keepOptionOrder Boolean  @default(false) // true = never shuffle the options (e.g. "All of the above")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  testLinks     McqTestQuestion[]
  answers       McqAnswer[]

  @@index([chapterId, isActive])
}

model McqTest {
  id            String     @id @default(cuid())
  title         String
  description   String?
  chapterId     String
  chapter       CourseNode @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  timeLimitMin  Int?       // null = untimed
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?
  shuffleQuestions Boolean @default(false) // true = each attempt gets its own question order
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  questions     McqTestQuestion[]
  attempts      McqAttempt[]

  @@index([chapterId, isPublished])
}

// Ordered list of questions in a test
model McqTestQuestion {
  testId     String
  test       McqTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   McqQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int

  @@id([testId, questionId])
  @@index([testId, position])
}

// Only submitted attempts by logged-in students are saved (guests and abandoned tests write nothing)
model McqAttempt {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId       String
  test         McqTest        @relation(fields: [testId], references: [id], onDelete: Restrict)
  score        Int
  total        Int
  timeTakenSec Int
  isLate       Boolean        @default(false) // submitted more than 60s after the time limit; still scored
  startedAt    DateTime       // from the server-signed start token, not the client clock
  submittedAt  DateTime       @default(now())

  answers      McqAnswer[]

  @@index([studentId, submittedAt])
  @@index([testId])
}

model McqAnswer {
  attemptId      String
  attempt        McqAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       McqQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption McqOption?  // null = skipped
  isCorrect      Boolean     // recorded at submit time, so later answer-key fixes don't rewrite old scores
  optionOrder    String?     // original options in the order shown, e.g. "CADB"; null = A-B-C-D (older attempts)
  position       Int?        // 1-based place of this question in the order shown; null = the test's order

  @@id([attemptId, questionId])
}